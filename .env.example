# ==============================================================================
# Application
# ==============================================================================

APP_NAME="Social Media API"
APP_ENV=development
APP_PORT=8000

# ==============================================================================
# PostgreSQL
# ==============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_media
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/social_media

TEST_DATABASE_NAME=social_media_test
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/social_media_test

# ==============================================================================
# Authentication
# ==============================================================================

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
